<!DOCTYPE html>
<html lang="et"> 	
<head>
	<meta charset="utf-8">
	<title>Eesti film</title>
</head>
<body>
	<h1>Eesti filmiinimeste lisamine</h1>
	<hr>
	<p>Lisa inimesi filmide andmebaasi</p>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilmid">Eesti filmi avaleht</a></li>
		<li><a href="/eestifilm/inimesed">Eesti filmi inimesed</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="firstNameInput">Filmiinimese eesnimi </label>
		<input id="firstNameInput" name="firstNameInput" type="text" placeholder="Eesnimi ..." value="<%= firstName %>" required>
		<br>
		<label for="lastNameInput">Filmiinimese perenimi</label>
		<input id="lastNameInput" name="lastNameInput" type="text" placeholder="Perekonnanimi ..." value="<%= lastName %>" required>
		<br>
		<label for="bornInput">Filmiinimese sünnikuupäev</label>
		<input id="bornInput" name="bornInput" type="date" value="<%= born %>" required>
		<label for="deceasedInput">Filmiinimese surmakuupäev</label>
		<input id="deceasedInput" name="deceasedInput" type="date" value="<%= deceased %>">
		<br>
		<input id="personSubmit" name="personSubmittype" type="submit" value="Salvesta"> 
	</form>
	<p><%= notice %>
</body>
</html>